# --- База данных (Supabase Postgres) ---
# Возьмите обе строки в Supabase: Project Settings -> Database -> Connection string
# DATABASE_URL — "Transaction" pooler (порт 6543, с ?pgbouncer=true) — использует приложение
# DIRECT_URL   — "Session"/прямое подключение (порт 5432) — использует Prisma для миграций
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Supabase Auth (вход в админ-панель) ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
