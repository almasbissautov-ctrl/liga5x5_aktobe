generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  FINISHED
}

enum Position {
  GK
  DEF
  MID
  FWD
}

enum MatchStatus {
  SCHEDULED
  FINISHED
  POSTPONED
  CANCELED
}

enum CardType {
  YELLOW
  RED
}

enum ApplicationStatus {
  NEW
  APPROVED
  REJECTED
}

model Season {
  id        String       @id @default(cuid())
  year      Int
  slug      String       @unique
  title     String
  status    SeasonStatus @default(UPCOMING)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime     @default(now())

  teams        Team[]
  matches      Match[]
  applications TeamApplication[]
}

// Команда привязана к конкретному сезону. Если команда играет несколько
// сезонов подряд — на новый сезон создаётся новая запись с тем же
// названием/логотипом. Так архив сезонов остаётся простым и независимым.
model Team {
  id          String   @id @default(cuid())
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  logoUrl     String?
  captainName String?
  coachName   String?
  city        String?
  createdAt   DateTime @default(now())

  players     Player[]
  homeMatches Match[]       @relation("HomeTeam")
  awayMatches Match[]       @relation("AwayTeam")
  goals       Goal[]
  cards       Card[]
  lineups     MatchLineup[]

  @@unique([seasonId, slug])
  @@index([seasonId])
}

model Player {
  id        String    @id @default(cuid())
  teamId    String
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  slug      String
  fullName  String
  number    Int?
  position  Position?
  photoUrl  String?
  isCaptain Boolean   @default(false)
  createdAt DateTime  @default(now())

  goalsScored   Goal[]        @relation("Scorer")
  goalsAssisted Goal[]        @relation("Assist")
  cards         Card[]
  lineups       MatchLineup[]
  mvpMatches    Match[]       @relation("MVP")

  @@unique([teamId, slug])
  @@index([teamId])
}

model Referee {
  id        String   @id @default(cuid())
  fullName  String
  phone     String?
  createdAt DateTime @default(now())

  matches Match[]
}

model Match {
  id                 String      @id @default(cuid())
  seasonId           String
  season             Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  round              Int?
  homeTeamId         String
  homeTeam           Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId         String
  awayTeam           Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  matchDate          DateTime
  venue              String?
  refereeId          String?
  referee            Referee?    @relation(fields: [refereeId], references: [id])
  status             MatchStatus @default(SCHEDULED)
  // homeScore/awayScore пересчитываются автоматически по таблице Goal
  // (см. syncMatchScore в lib/actions/matches.ts) — вручную не редактируются.
  homeScore          Int?
  awayScore          Int?
  mvpPlayerId        String?
  mvpPlayer          Player?     @relation("MVP", fields: [mvpPlayerId], references: [id])
  fullVideoUrl       String?
  highlightsVideoUrl String?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  goals   Goal[]
  cards   Card[]
  lineups MatchLineup[]

  @@index([seasonId])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model MatchLineup {
  id                String  @id @default(cuid())
  matchId           String
  match             Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId            String
  team              Team    @relation(fields: [teamId], references: [id])
  playerId          String
  player            Player  @relation(fields: [playerId], references: [id])
  isStarting        Boolean @default(true)
  isCaptainForMatch Boolean @default(false)

  @@unique([matchId, playerId])
}

// teamId = команда, которой засчитан гол (важно для автоголов: тогда
// scorerId будет игроком команды-соперника).
model Goal {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  scorerId  String
  scorer    Player   @relation("Scorer", fields: [scorerId], references: [id])
  assistId  String?
  assist    Player?  @relation("Assist", fields: [assistId], references: [id])
  minute    Int
  isOwnGoal Boolean  @default(false)
  isPenalty Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([matchId])
}

model Card {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  type      CardType
  minute    Int
  reason    String?
  createdAt DateTime @default(now())

  @@index([matchId])
}

model News {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String?
  content       String
  coverImageUrl String?
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Sponsor {
  id           String   @id @default(cuid())
  name         String
  logoUrl      String?
  websiteUrl   String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// Единственная запись с текстом регламента лиги, редактируется из админки
// (страница /admin/rules). Если записи ещё нет, публичная страница
// показывает текст по умолчанию.
model Regulation {
  id        String   @id @default(cuid())
  content   String
  updatedAt DateTime @updatedAt
}

model TeamApplication {
  id           String            @id @default(cuid())
  seasonId     String?
  season       Season?           @relation(fields: [seasonId], references: [id])
  teamName     String
  captainName  String
  captainPhone String
  city         String?
  comment      String?
  status       ApplicationStatus @default(NEW)
  createdAt    DateTime          @default(now())
}
